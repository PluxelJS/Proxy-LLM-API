# Documentation only. Edit the private .env generated by ./manage.sh init.
# Both are optional. With neither configured, CLIProxyAPI uses direct access.
SINGBOX_NODE_URL=
CF_TUNNEL_TOKEN=
CLIPROXY_ENGINE=podman
CLIPROXY_PROJECT=cliproxy-runtime
CLI_PROXY_IMAGE=localhost/proxy-llm-api/cli-proxy-api:local
# Full commit from https://github.com/router-for-me/CLIProxyAPI.git
CLIPROXY_REF=7fac6b15bcfe5ea55c18c9eaec8e5b7e6457d974
CLIPROXY_BIND_ADDRESS=127.0.0.1
CLIPROXY_PORT=8317
SINGBOX_IMAGE=ghcr.io/sagernet/sing-box:v1.13.16
CLOUDFLARED_IMAGE=docker.io/cloudflare/cloudflared:2026.7.3
API_ENTRY_IMAGE=docker.io/library/nginx:1.30.0-alpine
TZ=Asia/Taipei
SINGBOX_CHECK_URL=https://www.gstatic.com/generate_204
CLIPROXY_EXTERNAL_NETWORK=
